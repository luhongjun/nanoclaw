# NanoClaw Configuration

# Timezone
TZ=Asia/Shanghai

# OneCLI Gateway (credential injection)
ONECLI_URL=http://127.0.0.1:10254

# Anthropic API (or compatible endpoint)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_AUTH_TOKEN=your-token
# ANTHROPIC_MODEL=claude-sonnet-4-6

# WeCom Bot (Enterprise WeChat)
# WECOM_BOT_ID=your-bot-id
# WECOM_SECRET=your-secret

# Container Settings
# CONTAINER_IDLE_TIMEOUT_MS=300000  # 5 minutes - close container after idle
# CONTAINER_TIMEOUT=1800000         # 30 minutes - hard timeout for container execution
# MAX_CONCURRENT_CONTAINERS=5       # Max containers running simultaneously

# Logging
# LOG_LEVEL=info
